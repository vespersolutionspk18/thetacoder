{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@theta/chord": ["./packages/chord/src/index.ts"],
			"@theta/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@theta/chord/context": ["./packages/chord/src/context/index.ts"],
			"@theta/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@theta/chord/node": ["./packages/chord/src/node.ts"],
			"@theta/telemetry": ["./packages/telemetry/src/index.ts"],
			"@theta/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@theta/ai": ["./packages/ai/src/index.ts"],
			"@theta/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@theta/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@theta/ai/dist/*": ["./packages/ai/src/*"],
			"@theta/agent-core": ["./packages/agent/src/index.ts"],
			"@theta/agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@theta/agent-core/node": ["./packages/agent/src/node.ts"],
			"@theta/agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@theta/session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@theta/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@theta/coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@theta/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@theta/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@theta/protocol": ["./packages/protocol/src/index.ts"],
			"@theta/protocol/*": ["./packages/protocol/src/*"],
			"@theta/client": ["./packages/client/src/index.ts"],
			"@theta/client/unix": ["./packages/client/src/unix.ts"],
			"@theta/client/*": ["./packages/client/src/*"],
			"@theta/server": ["./packages/server/src/index.ts"],
			"@theta/server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@theta/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@theta/tui": ["./packages/tui/src/index.ts"],
			"@theta/tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}

