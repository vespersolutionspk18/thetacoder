{
	"name": "@theta/telemetry",
	"version": "0.85.1",
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for theta",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
		"license": "UNLICENSED",
		"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	}
}