{
	"name": "@theta/server",
	"version": "0.85.1",
	"description": "experimental server package for theta",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json"
},
	"keywords": [
		"theta",
		"server"
	],
		"license": "UNLICENSED",
		"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@theta/chord": "^0.85.1",
		"@theta/agent-core": "^0.85.1",
		"@theta/protocol": "^0.85.1"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}