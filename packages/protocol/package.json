{
	"name": "@theta/protocol",
	"version": "0.85.1",
	"description": "Transport-neutral CBOR protocol for remote theta sessions",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
},
	"keywords": [
		"theta",
		"protocol",
		"cbor",
		"binary",
		"framing"
	],
		"license": "UNLICENSED",
		"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@theta/chord": "^0.85.1",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}