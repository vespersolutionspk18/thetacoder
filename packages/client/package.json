{
	"name": "@theta/client",
	"version": "0.85.1",
	"description": "Transport-neutral client for remote theta sessions over framed CBOR bytes",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./unix": {
			"types": "./dist/unix.d.ts",
			"import": "./dist/unix.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json"
},
	"keywords": [
		"theta",
		"client",
		"protocol",
		"cbor",
		"binary"
	],
		"license": "UNLICENSED",
		"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@theta/chord": "^0.85.1",
		"@theta/protocol": "^0.85.1"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}